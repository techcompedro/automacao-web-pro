{
  "manifest_version": 2,
  "name": "Web Flow",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "91.1.0"
    }
  },
  "background": {
    "scripts": ["background.bundle.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon-128.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Abrir o painel"
    },
    "element-picker": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Abrir o seletor de elementos"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.bundle.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "optional_permissions": [
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "notifications",
    "cookies"
  ],
  "permissions": [
    "tabs",
    "proxy",
    "menus",
    "alarms",
    "storage",
    "webNavigation",
    "unlimitedStorage",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "/elementSelector.css",
    "/icon-128.png",
    "/Inter-roman-latin.var.woff2",
    "/locales/*",
    "elementSelector.bundle.js"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-inline' https:; object-src 'self'",
  "short_name": "Web Flow",
  "description": "Automatize o navegador com fluxos visuais: preencha formulários, extraia dados e agende tarefas."
}
